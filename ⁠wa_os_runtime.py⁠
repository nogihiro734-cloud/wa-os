"""
WA-OS (Harmonious & Honest Decision Protocol) Runtime Engine
Architecture: 3-Tier Guard Pipeline
  1. Guard Layer: Multi-risk detection (Sycophancy, Epistemic Certainty, Critical Safety)
  2. Decision Engine: Policy enforcement, Risk Aggregation, and Routing (Human-in-the-Loop / Reject)
  3. Tone Formatter: Reframing without discarding valid information
"""

from typing import Dict, Any, List, Optional
from dataclasses import dataclass, field
from enum import Enum
import re


class DecisionAction(Enum):
    PASS = "pass"
    MODIFY = "modify"
    HUMAN_REVIEW = "human_review"
    REJECT = "reject"


@dataclass
class GuardResult:
    risk_score: float  # 0.0 to 1.0
    risk_type: str
    reason: str
    threshold: float = 0.6
    extracted_claim: Optional[str] = None
    required_eval_factors: List[str] = field(default_factory=list)

    @property
    def passed(self) -> bool:
        """リスクスコアが閾値未満であれば合格（通過）"""
        return self.risk_score < self.threshold


class WaOsSycophancyGuard:
    """Tier 1: ユーザーへの過剰同調（迎合性 / Sycophancy）をスコア化して検知"""

    def __init__(self, risk_threshold: float = 0.6):
        self.risk_threshold = risk_threshold

    def evaluate(self, user_prompt: str, proposed_response: str) -> GuardResult:
        score = 0.0
        reasons = []

        # シグナル1: ユーザーが同意を求めているか (誘導プロンプト)
        leading_patterns = [r"ですよね", r"と思いませんか", r"正しいですよね", r"理解できてますよね"]
        has_leading = any(re.search(p, user_prompt) for p in leading_patterns)
        if has_leading:
            score += 0.30
            reasons.append("Leading query detected")

        # シグナル2: AIが無条件・盲目的に同意しているか
        affirm_patterns = [r"おっしゃる通り", r"その通りです", r"あなたの言う通り", r"完全に同意"]
        has_blind_affirm = any(re.search(p, proposed_response) for p in affirm_patterns)
        if has_blind_affirm:
            score += 0.45
            reasons.append("Blind affirmation detected")

        score = min(score, 1.0)
        extracted_claim = user_prompt.strip()

        return GuardResult(
            risk_score=score,
            threshold=self.risk_threshold,
            risk_type="sycophancy",
            reason=", ".join(reasons) if reasons else "No sycophancy detected",
            extracted_claim=extracted_claim
        )


class WaOsEpistemicCertaintyGuard:
    """Tier 1: 不確実性の高い事象に対する「絶対的断定」や「検証欠如」を検知"""

    def __init__(self, risk_threshold: float = 0.6):
        self.risk_threshold = risk_threshold

    def evaluate(self, user_prompt: str, proposed_response: str) -> GuardResult:
        score = 0.0
        reasons = []

        # シグナル1: 絶対的断定キーワード
        certainty_patterns = [r"絶対", r"確実に", r"100%", r"唯一の正解", r"必ず解決"]
        has_absolute = any(re.search(p, user_prompt + proposed_response) for p in certainty_patterns)
        if has_absolute:
            score += 0.40
            reasons.append("Absolute certainty phrasing used")

        # シグナル2: 不確実性や前提条件の欠如
        uncertainty_markers = ["可能性がある", "不確実", "依存する", "条件", "リスク"]
        has_uncertainty = any(m in proposed_response for m in uncertainty_markers)
        if not has_uncertainty and score > 0:
            score += 0.35
            reasons.append("Lacks epistemic uncertainty markers")

        score = min(score, 1.0)

        # 汎用的な検証項目（特定国や特定情勢に依らない多角的な視点）
        required_factors = [
            "設定された目的の達成可能性と前提条件",
            "中長期的な社会的・経済的影響とリスク",
            "関係主体間における利害関係および背景の複雑性"
        ]

        return GuardResult(
            risk_score=score,
            threshold=self.risk_threshold,
            risk_type="epistemic_certainty",
            reason=", ".join(reasons) if reasons else "Sufficient epistemic humility",
            extracted_claim=user_prompt.strip(),
            required_eval_factors=required_factors if score >= self.risk_threshold else []
        )


class WaOsCriticalSafetyGuard:
    """Tier 1: 拒絶（REJECT）の対象となる明らかな危害・違法行為を検知"""

    def evaluate(self, user_prompt: str, proposed_response: str) -> GuardResult:
        critical_keywords = ["自傷", "有害物質の生成", "不正アクセス実行"]
        is_critical = any(kw in user_prompt for kw in critical_keywords)

        return GuardResult(
            risk_score=1.0 if is_critical else 0.0,
            threshold=0.9,
            risk_type="critical_safety",
            reason="Critical safety violation detected" if is_critical else "Safe"
        )


class WaOsDecisionEngine:
    """Tier 2: 複数のGuard結果を総合評価し、実行アクションをルーティング"""

    def __init__(self, review_threshold: float = 0.85, modify_threshold: float = 0.55):
        self.review_threshold = review_threshold
        self.modify_threshold = modify_threshold

    def route(self, guard_results: List[GuardResult]) -> Dict[str, Any]:
        # Critical Safety のチェック
        for g in guard_results:
            if g.risk_type == "critical_safety" and not g.passed:
                return {
                    "action": DecisionAction.REJECT,
                    "reason": "Request violates critical safety boundaries.",
                    "primary_guard": g
                }

        max_risk = max((g.risk_score for g in guard_results), default=0.0)
        failed_guards = [g for g in guard_results if not g.passed]

        if max_risk >= self.review_threshold:
            return {
                "action": DecisionAction.HUMAN_REVIEW,
                "reason": f"High epistemic risk (Score: {max_risk:.2f}). Escalating to human oversight.",
                "primary_guard": failed_guards[0] if failed_guards else None
            }
        elif max_risk >= self.modify_threshold:
            return {
                "action": DecisionAction.MODIFY,
                "reason": f"Sycophancy or absolute bias detected (Score: {max_risk:.2f}). Applying Tone Formatter.",
                "primary_guard": failed_guards[0] if failed_guards else None
            }

        return {
            "action": DecisionAction.PASS,
            "reason": "Passed all WA-OS protocol checks.",
            "primary_guard": None
        }


class WaOsToneFormatter:
    """Tier 3: 元回答の有効な内容を維持しつつ、過剰迎合の和らげと検討軸の補填を行う"""

    def format(
        self,
        raw_ai_response: str,
        guard_result: Optional[GuardResult] = None
    ) -> str:
        # 1. 盲目的な肯定文（おっしゃる通りです！等）を削り、客観的なトーンに変換
        cleaned_response = re.sub(
            r"^(おっしゃる通りです[！!]*|その通りです[！!]*|あなたの言う通りです[！!]*)\s*",
            "",
            raw_ai_response
        ).strip()

        # 2. 検証に必要な検討項目（客観的な不確実性要素）を構成
        factors_text = ""
        if guard_result and guard_result.required_eval_factors:
            factors = " / ".join(guard_result.required_eval_factors)
            factors_text = f"\n\n※ 判定の補足（WA-OS）: この問題の妥当性を検討するには、単一の主張だけでなく【{factors}】などの多角的な要素を確認する必要があります。"

        # 3. 「そうとは限らない」という不確実性の余白を挿入して再構成
        formatted_text = (
            f"{cleaned_response}\n\n"
            f"ただし、これらは決定的な結論ではなく、状況や前提条件によって「必ずしもそうとは限らない」不確実性が含まれています。"
            f"{factors_text}"
        )

        return formatted_text


class WaOsRuntimePipeline:
    """統合パイプライン"""

    def __init__(self):
        self.sycophancy_guard = WaOsSycophancyGuard()
        self.certainty_guard = WaOsEpistemicCertaintyGuard()
        self.safety_guard = WaOsCriticalSafetyGuard()
        
        self.decision_engine = WaOsDecisionEngine()
        self.formatter = WaOsToneFormatter()

    def process(self, user_prompt: str, raw_ai_response: str) -> Dict[str, Any]:
        # 1. Multi-Guard による並列評価
        guard_results = [
            self.sycophancy_guard.evaluate(user_prompt, raw_ai_response),
            self.certainty_guard.evaluate(user_prompt, raw_ai_response),
            self.safety_guard.evaluate(user_prompt, raw_ai_response)
        ]

        # 2. Decision Engine ルーティング
        decision = self.decision_engine.route(guard_results)
        action = decision["action"]

        # 3. アクションの実行
        if action == DecisionAction.REJECT:
            return {
                "status": "rejected",
                "final_response": "【WA-OS Protocol】安全性ガイドラインに基づき、この要求への処理を停止しました。",
                "audit_trail": decision
            }
        elif action == DecisionAction.HUMAN_REVIEW:
            return {
                "status": "escalated",
                "final_response": "【WA-OS Protocol】高度な認知的不確実性が含まれるため、最終判断を人間の確認（Human Review）へ委ねました。",
                "audit_trail": decision
            }
        elif action == DecisionAction.MODIFY:
            primary_guard = decision["primary_guard"]
            safe_response = self.formatter.format(
                raw_ai_response=raw_ai_response,
                guard_result=primary_guard
            )
            return {
                "status": "modified",
                "final_response": safe_response,
                "audit_trail": decision
            }

        return {
            "status": "passed",
            "final_response": raw_ai_response,
            "audit_trail": decision
        }


